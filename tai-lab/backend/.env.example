# Server-side defaults. Per-user keys come from the frontend per-request and
# are NEVER persisted server-side in the PoC.

# Path to the Body of Knowledge root (the trustworthy-ai repo root).
# Defaults to ../.. relative to the backend directory.
BOK_ROOT=../..

# Comma-separated list of allowed CORS origins for the frontend.
CORS_ORIGINS=http://localhost:3000

# Optional: a server-side fallback Anthropic key for demos where the user has
# not configured BYOK. Leave empty in production.
ANTHROPIC_API_KEY=

# Hard cap on tokens per request to prevent runaway cost.
MAX_OUTPUT_TOKENS=2048

# Cache TTL flavour for the BoK system prompt: "5m" or "1h".
# 5m is cheaper to write but expires faster; 1h costs 2x to write but lasts longer.
# See docs/prompt-caching.md for the economics.
ANTHROPIC_CACHE_TTL=5m
